POSTGRES_DB=disaster_db
POSTGRES_USER=disaster
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=disaster_db
POSTGRES_PORT=5432
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
# 上下文長度要放得下 20 至 30 筆避難所文件；輸出長度要列得完清單
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=800
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
SYNC_API_KEY=change_me_to_a_long_random_string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
SESSION_SECRET=change_me_to_a_long_random_string
SESSION_HOURS=12
# 選配：給 curl / 排程腳本用的寫入金鑰，留空即停用
WRITE_API_KEY=
# 前面有反向代理（Caddy / nginx）時設 true：登入節流才會用真實來源 IP，HTTPS 才會標記 cookie Secure。
# 直接對外時保持 false，否則任何人自己帶 X-Forwarded-For 就能繞過登入節流
TRUST_PROXY_HEADERS=false
# 容器對外綁定的位址。預設只綁本機，讓反向代理轉進來；沒有代理要給區網直接連時改 0.0.0.0
APP_BIND=127.0.0.1
# 同時進行的 AI 生成上限，超過的問題立刻回 429 而不是排隊
CHAT_MAX_CONCURRENT=2
# 資料庫連線與單一 SQL 的逾時，資料庫卡住時請求要能在幾秒內失敗
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=15000
